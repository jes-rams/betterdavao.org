{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betterdavao-org",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out"
  },
  "routes": [
    {
      "pattern": "betterdavao.org",
      "custom_domain": true
    },
    {
      "pattern": "www.betterdavao.org",
      "custom_domain": true
    }
  ]
}
